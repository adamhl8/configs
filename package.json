{
  "name": "@adamhl8/configs",
  "version": "3.1.1",
  "description": "My shared configs for TS projects",
  "homepage": "https://github.com/adamhl8/configs",
  "bugs": {
    "url": "https://github.com/adamhl8/configs/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Adam Langbert",
    "email": "adamhl@pm.me",
    "url": "https://github.com/adamhl8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamhl8/configs.git"
  },
  "bin": {
    "adamhl8-bunfig": "./dist/adamhl8-bunfig/index",
    "adamhl8-gitignore": "./dist/adamhl8-gitignore/index"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./tsconfig": "./dist/configs/tsconfig.base.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "import": "./dist/env/index.js"
    },
    "./bask": {
      "types": "./dist/configs/bask.base.d.ts",
      "import": "./dist/configs/bask.base.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "bask prepare"
  },
  "dependencies": {
    "@adamhl8/eslint-plugin-clean-modules": "^0.1.5",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@e18e/eslint-plugin": "^0.8.1",
    "arkenv": "^0.12.3",
    "arktype": "^2.2.9",
    "es-toolkit": "^1.53.0",
    "eslint-plugin-bunisms": "^0.11.0",
    "eslint-plugin-hono": "^1.1.0",
    "eslint-plugin-react-web-api": "^5.28.8",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-regexp": "^3.3.1",
    "oxlint-plugin-directive-comments": "^0.1.0",
    "oxlint-tailwindcss": "^1.16.0",
    "ts-explicit-errors": "^4.1.3",
    "type-fest": "^5.10.0"
  },
  "devDependencies": {
    "@adamhl8/bask": "^0.5.0",
    "@adamhl8/configs": "file:.",
    "@arethetypeswrong/core": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@types/bun": "^1.4.4",
    "knip": "^6.43.0",
    "markdown-toc": "^1.2.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "release-it": "^21.1.1",
    "release-it-git-cliff": "^0.2.0",
    "tsdown": "^0.23.2",
    "typescript": "7.1.0-beta"
  },
  "peerDependencies": {
    "@adamhl8/bask": ">=0.5",
    "@arethetypeswrong/core": ">=0.18",
    "@commitlint/cli": ">=21.2",
    "@commitlint/config-conventional": ">=21.2",
    "@tailwindcss/language-server": ">=0.16",
    "knip": ">=6.43",
    "markdown-toc": ">=1.2",
    "oxfmt": ">=0.74",
    "oxlint": ">=1.89",
    "oxlint-tsgolint": ">=7.0.2005",
    "publint": ">=0.3",
    "release-it": ">=21.1",
    "release-it-git-cliff": ">=0.2",
    "tailwint": ">=1.1",
    "tsdown": ">=0.23.2",
    "typescript": "^7.1.0-beta"
  },
  "peerDependenciesMeta": {
    "@arethetypeswrong/core": {
      "optional": true
    },
    "@tailwindcss/language-server": {
      "optional": true
    },
    "publint": {
      "optional": true
    },
    "release-it": {
      "optional": true
    },
    "release-it-git-cliff": {
      "optional": true
    },
    "tailwint": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4"
  }
}
